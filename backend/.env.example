PORT=3000
# MongoDB local hoặc connection string của MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/QLHocPhan

# Tạo chuỗi ngẫu nhiên ít nhất 32 byte, không dùng giá trị mẫu khi chạy thật.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Một tài khoản quản trị duy nhất. Điền mật khẩu riêng, tối thiểu 8 ký tự.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULLNAME=Quản trị viên

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=QLHocPhan
