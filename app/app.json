{
  "expo": {
    "name": "Lecturer Management",
    "slug": "init-prj",
    "scheme": "initprj",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-image",
      "expo-localization",
      "expo-sharing"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
